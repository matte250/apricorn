@@ -0,0 +1,361 @@
+/*
+    apricorn-platform — headless implementation of melonDS's Platform
+    interface for the apricorn oracle.
+
+    melonDS's core calls into the `melonDS::Platform::` namespace for
+    everything host-side (files, logging, threads, mic, wifi packets,
+    save writes), but every real implementation lives in the Qt/SDL
+    frontend — which the core-only oracle build deliberately excludes.
+    This file supplies the headless versions: real stdio for files,
+    stderr for logs, real C++11 threading primitives (the core links
+    against them even when it never spawns a thread in this
+    configuration), and deterministic no-op stubs for everything
+    that would reach the outside world — no host time, no network,
+    no devices, nothing that could make two runs differ.
+*/
+
+#include "Platform.h"
+
+#include <atomic>
+#include <cstdint>
+#include <cstdarg>
+#include <cstdio>
+#include <cstring>
+#include <chrono>
+#include <condition_variable>
+#include <mutex>
+#include <thread>
+
+namespace melonDS
+{
+namespace Platform
+{
+
+// ----- stop signaling ------------------------------------------------------
+
+static std::atomic<StopReason> gStopReason{StopReason(-1)};
+
+void SignalStop(StopReason reason, void* userdata)
+{
+    (void)userdata;
+    gStopReason.store(reason);
+}
+
+bool Stopped()
+{
+    return gStopReason.load() != StopReason(-1);
+}
+
+// ----- files ----------------------------------------------------------------
+
+struct FileHandle { FILE* file; };
+
+// Maps the Platform FileMode flags onto an fopen mode string (without the
+// 'b'; the caller appends it unless Text mode was requested).
+static const char* ModeString(FileMode mode)
+{
+    bool read = mode & FileMode::Read;
+    bool write = mode & FileMode::Write;
+
+    if (read && write)  return (mode & FileMode::NoCreate) ? "r+" : "w+";
+    if (write)
+    {
+        if (mode & FileMode::Append)   return "a";
+        if (mode & FileMode::Preserve) return "r+";
+        return "w";
+    }
+    return "r";
+}
+
+static FILE* OpenImpl(const std::string& path, FileMode mode)
+{
+    bool read = mode & FileMode::Read;
+    bool write = mode & FileMode::Write;
+    if (!read && !write) return nullptr;
+
+    char m[8];
+    int i = 0;
+    const char* s = ModeString(mode);
+    for (; s[i]; i++) m[i] = s[i];
+    if (!(mode & FileMode::Text)) { m[i++] = 'b'; }
+    m[i] = '\0';
+
+    if ((mode & FileMode::NoCreate) && !(mode & FileMode::Read))
+    {
+        FILE* probe = fopen(path.c_str(), "rb");
+        if (!probe) return nullptr;
+        fclose(probe);
+    }
+
+    return fopen(path.c_str(), m);
+}
+
+std::string GetLocalFilePath(const std::string& filename)
+{
+    // Headless: no per-user config directory — paths are taken as given.
+    return filename;
+}
+
+FileHandle* OpenFile(const std::string& path, FileMode mode)
+{
+    FILE* f = OpenImpl(path, mode);
+    if (!f) return nullptr;
+    return new FileHandle{f};
+}
+
+// The oracle has no local-file concept (no melonDS.ini, no BIOS dumps);
+// local and plain files are the same thing.
+FileHandle* OpenLocalFile(const std::string& path, FileMode mode)
+{
+    return OpenFile(path, mode);
+}
+
+static bool ExistsImpl(const std::string& name)
+{
+    FILE* f = fopen(name.c_str(), "rb");
+    if (!f) return false;
+    fclose(f);
+    return true;
+}
+
+bool FileExists(const std::string& name) { return ExistsImpl(name); }
+bool LocalFileExists(const std::string& name) { return ExistsImpl(name); }
+
+bool CheckFileWritable(const std::string& filepath) { return OpenImpl(filepath, FileMode::ReadWrite) != nullptr; }
+bool CheckLocalFileWritable(const std::string& filepath) { return CheckFileWritable(filepath); }
+
+bool CloseFile(FileHandle* file)
+{
+    if (!file) return false;
+    bool ok = fclose(file->file) == 0;
+    delete file;
+    return ok;
+}
+
+bool IsEndOfFile(FileHandle* file) { return file && feof(file->file); }
+
+bool FileReadLine(char* str, int count, FileHandle* file)
+{
+    return file && fgets(str, count, file->file) != nullptr;
+}
+
+u64 FilePosition(FileHandle* file) { return file ? u64(ftell(file->file)) : 0; }
+
+bool FileSeek(FileHandle* file, s64 offset, FileSeekOrigin origin)
+{
+    if (!file) return false;
+    int whence = origin == FileSeekOrigin::Start ? SEEK_SET
+                : origin == FileSeekOrigin::Current ? SEEK_CUR : SEEK_END;
+    // ftell/fseek are long (32-bit on Windows); 64-bit files go through
+    // the long long variants when the offset can't round-trip.
+    if (offset >= INT32_MIN && offset <= INT32_MAX)
+        return fseek(file->file, long(offset), whence) == 0;
+    return _fseeki64(file->file, offset, whence) == 0;
+}
+
+void FileRewind(FileHandle* file) { if (file) rewind(file->file); }
+
+u64 FileRead(void* data, u64 size, u64 count, FileHandle* file)
+{
+    return file ? u64(fread(data, size_t(size), size_t(count), file->file)) : 0;
+}
+
+bool FileFlush(FileHandle* file) { return file && fflush(file->file) == 0; }
+
+u64 FileWrite(const void* data, u64 size, u64 count, FileHandle* file)
+{
+    return file ? u64(fwrite(data, size_t(size), size_t(count), file->file)) : 0;
+}
+
+u64 FileWriteFormatted(FileHandle* file, const char* fmt, ...)
+{
+    if (!file) return 0;
+    va_list args;
+    va_start(args, fmt);
+    int written = vfprintf(file->file, fmt, args);
+    va_end(args);
+    return written < 0 ? 0 : u64(written);
+}
+
+u64 FileLength(FileHandle* file)
+{
+    if (!file) return 0;
+    long old = ftell(file->file);
+    fseek(file->file, 0, SEEK_END);
+    long len = ftell(file->file);
+    fseek(file->file, old, SEEK_SET);
+    return len < 0 ? 0 : u64(len);
+}
+
+// ----- logging ---------------------------------------------------------------
+
+// Logs go to stderr; they never touch the trace on stdout-bound files.
+void Log(LogLevel level, const char* fmt, ...)
+{
+    const char* prefix = level == LogLevel::Debug ? " debug: "
+                       : level == LogLevel::Info  ? " "
+                       : level == LogLevel::Warn  ? " warning: "
+                                                  : " error: ";
+    fputs("melonDS", stderr);
+    fputs(prefix, stderr);
+    va_list args;
+    va_start(args, fmt);
+    vfprintf(stderr, fmt, args);
+    va_end(args);
+    fputc('\n', stderr);
+}
+
+// ----- threads / sync ---------------------------------------------------------
+
+struct Thread { std::thread thread; };
+struct Mutex { std::mutex mutex; };
+struct Semaphore
+{
+    std::mutex mutex;
+    std::condition_variable cond;
+    int count = 0;
+};
+
+Thread* Thread_Create(std::function<void()> func)
+{
+    try
+    {
+        return new Thread{std::thread(func)};
+    }
+    catch (...)
+    {
+        return nullptr;
+    }
+}
+
+void Thread_Free(Thread* thread)
+{
+    if (thread)
+    {
+        if (thread->thread.joinable()) thread->thread.join();
+        delete thread;
+    }
+}
+
+void Thread_Wait(Thread* thread)
+{
+    if (thread && thread->thread.joinable()) thread->thread.join();
+}
+
+Mutex* Mutex_Create() { try { return new Mutex; } catch (...) { return nullptr; } }
+void Mutex_Free(Mutex* mutex) { delete mutex; }
+void Mutex_Lock(Mutex* mutex) { if (mutex) mutex->mutex.lock(); }
+void Mutex_Unlock(Mutex* mutex) { if (mutex) mutex->mutex.unlock(); }
+bool Mutex_TryLock(Mutex* mutex) { return mutex && mutex->mutex.try_lock(); }
+
+Semaphore* Semaphore_Create() { try { return new Semaphore; } catch (...) { return nullptr; } }
+void Semaphore_Free(Semaphore* sema) { delete sema; }
+void Semaphore_Reset(Semaphore* sema) { if (!sema) return; std::lock_guard<std::mutex> lock(sema->mutex); sema->count = 0; }
+void Semaphore_Wait(Semaphore* sema)
+{
+    if (!sema) return;
+    std::unique_lock<std::mutex> lock(sema->mutex);
+    sema->cond.wait(lock, [sema] { return sema->count > 0; });
+    sema->count--;
+}
+bool Semaphore_TryWait(Semaphore* sema, int timeout_ms)
+{
+    if (!sema) return false;
+    std::unique_lock<std::mutex> lock(sema->mutex);
+    if (timeout_ms > 0)
+        if (!sema->cond.wait_for(lock, std::chrono::milliseconds(timeout_ms), [sema] { return sema->count > 0; }))
+            return false;
+    if (sema->count <= 0) return false;
+    sema->count--;
+    return true;
+}
+void Semaphore_Post(Semaphore* sema, int count)
+{
+    if (!sema) return;
+    std::lock_guard<std::mutex> lock(sema->mutex);
+    sema->count += count;
+    sema->cond.notify_all();
+}
+
+void Sleep(u64 usecs)
+{
+    std::this_thread::sleep_for(std::chrono::microseconds(usecs));
+}
+
+// Host wall-clock — never used in the oracle's execution path (frame-indexed
+// only), but provided so the core links if a debug path ever asks.
+static u64 Ticks()
+{
+    return u64(std::chrono::steady_clock::now().time_since_epoch().count());
+}
+u64 GetMSCount() { return Ticks() / 1000000; }
+u64 GetUSCount() { return Ticks() / 1000; }
