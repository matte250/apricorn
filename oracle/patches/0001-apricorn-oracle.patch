+#include "NDS.h"
+#include "NDSCart.h"
+#include "GPU3D_Soft.h"
+#include "sha1/sha1.hpp" // extern "C" wrapper — sha1.c is compiled as C
+
+// melonDS's fixed-width aliases are namespaced; the oracle uses them
+// unqualified like the rest of the codebase.
+using melonDS::u8;
+using melonDS::u16;
+using melonDS::u32;
+using melonDS::u64;
+using melonDS::s32;
+
+// apricorn-platform.cpp: the headless stop flag set by SignalStop.
+namespace melonDS { namespace Platform { bool Stopped(); } }
+
+namespace {
+
+// ----- constants ----------------------------------------------------------
+
+// One NDS video frame at 59.8268 Hz — informational, pinned in the trace.
+constexpr const char* FRAME_RATE = "59.8268";
+// Default pinned RTC (the trace header records whichever was used).
+constexpr const char* DEFAULT_RTC = "2010-03-01T09:00:00";
+// melonDS text-format version of our trace (TRACE apricorn 1) and the
+// engine state version it must agree with (STATE_FORMAT_VERSION == 1).
+constexpr const char* TRACE_VERSION = "1";
+constexpr const char* STATE_FORMAT = "1";
+
+// The fake return address for probes. arm-runner uses 0xFFFF0000; here
+// the address must be *mapped* (melonDS prefetches code eagerly at
+// JumpTo), so we use the top of the probe stack: pushes land below it
+// and the probe loop stops before the PC is ever fetched.
+constexpr u32 PROBE_SENTINEL = 0x02300000;
+constexpr u32 PROBE_STACK_TOP = 0x02300000;
+constexpr u32 PROBE_STEP_BUDGET = 4 * 1024 * 1024; // same as arm-runner
+
+// One NDS LCD.
+constexpr u32 SCREEN_W = 256;
+constexpr u32 SCREEN_H = 192;
+
+// ----- small utilities ----------------------------------------------------
+
+struct Blob
+{
+    std::vector<u8> data;
+    size_t pos = 0;
+
+    bool eof() const { return pos >= data.size(); }
+    u32 rd32()
+    {
+        if (pos + 4 > data.size()) { fprintf(stderr, "corrupt blob: short u32\n"); exit(2); }
+        u32 v = data[pos] | (data[pos+1] << 8) | (data[pos+2] << 16) | (u32(data[pos+3]) << 24);
+        pos += 4;
+        return v;
+    }
+    u16 rd16()
+    {
+        if (pos + 2 > data.size()) { fprintf(stderr, "corrupt blob: short u16\n"); exit(2); }
+        u16 v = data[pos] | (data[pos+1] << 8);
+        pos += 2;
+        return v;
+    }
+    u8 rd8()
+    {
+        if (pos >= data.size()) { fprintf(stderr, "corrupt blob: short u8\n"); exit(2); }
+        return data[pos++];
+    }
+    std::string rdstr(u32 len)
+    {
+        if (pos + len > data.size()) { fprintf(stderr, "corrupt blob: short string\n"); exit(2); }
+        std::string s(reinterpret_cast<char*>(&data[pos]), len);
+        pos += len;
+        return s;
+    }
+};
+
+std::vector<u8> ReadFile(const char* path)
+{
+    FILE* f = fopen(path, "rb");
+    if (!f) { fprintf(stderr, "cannot open %s\n", path); exit(2); }
+    fseek(f, 0, SEEK_END);
+    long len = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    std::vector<u8> data(len);
+    if (len > 0 && fread(data.data(), len, 1, f) != 1) { fprintf(stderr, "read error on %s\n", path); exit(2); }
+    fclose(f);
+    return data;
+}
+
+void WriteFile(const std::string& path, const std::vector<u8>& data)
+{
+    FILE* f = fopen(path.c_str(), "wb");
+    if (!f) { fprintf(stderr, "cannot write %s\n", path.c_str()); exit(2); }
+    if (!data.empty() && fwrite(data.data(), data.size(), 1, f) != 1)
+    {
+        fprintf(stderr, "write error on %s\n", path.c_str());
+        exit(2);
+    }
+    fclose(f);
+}
+
+std::string Sha1Hex(const u8* data, size_t len)
+{
+    SHA1_CTX ctx;
+    SHA1Init(&ctx);
+    SHA1Update(&ctx, const_cast<unsigned char*>(data), u32(len));
+    unsigned char digest[20];
+    SHA1Final(digest, &ctx);
+    char hex[41];
+    for (int i = 0; i < 20; i++) sprintf(&hex[i*2], "%02x", digest[i]);
+    return std::string(hex, 40);
+}
+
+// ----- screenshots --------------------------------------------------------
+//
+// `--shots` writes both LCDs as 256x192 RGB8 PNGs at the end of each
+// listed frame. melonDS's software renderer leaves a completed frame
+// in GPU.Framebuffer[GPU.FrontBuffer][0 = top, 1 = bottom] as
+// 0xFFRRGGBB words (GPU2D_Soft.cpp's final pass: the 6-bit channels
+// expanded to 8 with the top two bits replicated into the bottom two,
+// red in bits 16-23, green in 8-15, blue in 0-7, alpha 0xFF; "BGRA"
+// only as a byte order). FrontBuffer flips at every FinishFrame, so
+// after RunFrame it indexes the frame just finished — the same buffer
+// the Qt frontend displays.
+//
+// The core build doesn't link zlib, so the encoder is self-contained:
+// the IDAT zlib stream is made of stored (uncompressed) deflate
+// blocks, leaving only the two checksums to compute — CRC-32 per
+// chunk, Adler-32 for the zlib trailer. ~148 KB per LCD; review
+// artifacts, never committed.
+
+u32 Crc32(const u8* data, size_t len)
+{
+    static u32 table[256];
+    static bool ready = false;
+    if (!ready)
+    {
+        for (u32 n = 0; n < 256; n++)
+        {
+            u32 c = n;
+            for (int k = 0; k < 8; k++)
+                c = (c & 1) ? (0xEDB88320u ^ (c >> 1)) : (c >> 1);
+            table[n] = c;
+        }
+        ready = true;
+    }
+    u32 crc = 0xFFFFFFFFu;
+    for (size_t i = 0; i < len; i++)
+        crc = table[(crc ^ data[i]) & 0xFF] ^ (crc >> 8);
+    return crc ^ 0xFFFFFFFFu;
+}
+
+void PutBE32(std::vector<u8>& out, u32 v)
+{
+    out.push_back(u8(v >> 24));
+    out.push_back(u8(v >> 16));
+    out.push_back(u8(v >> 8));
+    out.push_back(u8(v));
+}
+
+void PutLE32(std::vector<u8>& out, u32 v)
+{
+    out.push_back(u8(v));
+    out.push_back(u8(v >> 8));
+    out.push_back(u8(v >> 16));
+    out.push_back(u8(v >> 24));
+}
+
+// One PNG chunk: big-endian length, 4-byte type, data, CRC-32 over
+// type + data.
+void PngChunk(std::vector<u8>& out, const char* type, const std::vector<u8>& data)
+{
+    PutBE32(out, u32(data.size()));
+    size_t start = out.size();
+    out.insert(out.end(), type, type + 4);
+    out.insert(out.end(), data.begin(), data.end());
+    PutBE32(out, Crc32(&out[start], out.size() - start));
+}
+
+// A zlib stream (RFC 1950) of stored deflate blocks (RFC 1951 §3.2.4):
+// header 0x78 0x01, blocks of at most 65535 bytes each carrying
+// BFINAL/BTYPE=00, LEN, NLEN (ones' complement), the bytes; then the
+// big-endian Adler-32 of the raw data.
+std::vector<u8> ZlibStored(const std::vector<u8>& raw)
+{
+    std::vector<u8> z;
+    z.push_back(0x78);
+    z.push_back(0x01);
+    size_t pos = 0;
+    do
+    {
+        size_t n = std::min<size_t>(raw.size() - pos, 65535);
+        bool last = pos + n == raw.size();
+        z.push_back(last ? 1 : 0);
+        z.push_back(u8(n));
+        z.push_back(u8(n >> 8));
+        z.push_back(u8(~n));
+        z.push_back(u8(~n >> 8));
+        z.insert(z.end(), raw.begin() + pos, raw.begin() + pos + n);
+        pos += n;
+    } while (pos < raw.size());
+    u32 a = 1, b = 0;
+    for (u8 byte : raw)
+    {
+        a = (a + byte) % 65521;
+        b = (b + a) % 65521;
+    }
+    PutBE32(z, (b << 16) | a);
+    return z;
+}
+
+// Encodes one LCD (SCREEN_W x SCREEN_H words of 0xFFRRGGBB, `stride`
+// words per row) as an 8-bit truecolour PNG with filter type None on
+// every row.
+std::vector<u8> EncodeScreenPng(const u32* fb, u32 stride)
+{
+    std::vector<u8> raw;
+    raw.reserve(SCREEN_H * (1 + SCREEN_W * 3));
+    for (u32 y = 0; y < SCREEN_H; y++)
+    {
+        raw.push_back(0); // filter type: None
+        for (u32 x = 0; x < SCREEN_W; x++)
+        {
+            u32 px = fb[y * stride + x];
+            raw.push_back(u8(px >> 16)); // R
+            raw.push_back(u8(px >> 8));  // G
+            raw.push_back(u8(px));       // B
+        }
+    }
+
+    std::vector<u8> png = { 0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A };
+    std::vector<u8> ihdr;
+    PutBE32(ihdr, SCREEN_W);
+    PutBE32(ihdr, SCREEN_H);
+    ihdr.push_back(8); // bit depth
+    ihdr.push_back(2); // colour type: truecolour (RGB)
+    ihdr.push_back(0); // compression: deflate
+    ihdr.push_back(0); // filter method: adaptive (per-row type bytes)
+    ihdr.push_back(0); // no interlace
+    PngChunk(png, "IHDR", ihdr);
+    PngChunk(png, "IDAT", ZlibStored(raw));
+    PngChunk(png, "IEND", {});
+    return png;
+}
+
+// Writes the frame just completed: <dir>/frame_%06u_top.png and
+// <dir>/frame_%06u_bottom.png. Framebuffer[..][0] is always the top
+// LCD (AssignFramebuffers routes the engines by POWCNT1's display
+// swap), and the software renderer's row stride is one screen width.
+void WriteShots(melonDS::NDS& nds, const std::string& dir, u32 frame)
+{
+    u32 stride = nds.GPU.GPU3D.IsRendererAccelerated() ? (256*3 + 1) : 256;
+    const u32* top = nds.GPU.Framebuffer[nds.GPU.FrontBuffer][0].get();
+    const u32* bottom = nds.GPU.Framebuffer[nds.GPU.FrontBuffer][1].get();
+    char name[64];
+    snprintf(name, sizeof(name), "/frame_%06u_top.png", frame);
+    WriteFile(dir + name, EncodeScreenPng(top, stride));
+    snprintf(name, sizeof(name), "/frame_%06u_bottom.png", frame);
+    WriteFile(dir + name, EncodeScreenPng(bottom, stride));
+}
+
+// Writes the software 3D core before engine-A/B compositing.  The
+// little-endian APGX3D1 stream contains width/height followed by one
+// `{color, depth, attributes}` u32 triplet per pixel.  `color` is the
+// renderer's native packed 6-bit RGB / 5-bit alpha value; depth and
+// attributes are the exact planes used for depth tests, polygon ids,
+// fog and edge coverage.
+void WriteGxShot(melonDS::NDS& nds, const std::string& dir, u32 frame)
+{
+    auto* soft = dynamic_cast<melonDS::SoftRenderer*>(&nds.GPU.GPU3D.GetCurrentRenderer());
+    if (!soft)
+    {
+        fprintf(stderr, "--gx-shots requires the software 3D renderer\n");
+        exit(2);
+    }
+    std::vector<u8> raw = {'A','P','G','X','3','D','1',0};
+    PutLE32(raw, SCREEN_W);
+    PutLE32(raw, SCREEN_H);
+    raw.reserve(raw.size() + SCREEN_W * SCREEN_H * 12);
+    for (u32 y = 0; y < SCREEN_H; y++)
+    {
+        const u32* color = nds.GPU.GPU3D.GetLine(y);
+        for (u32 x = 0; x < SCREEN_W; x++)
+        {
+            PutLE32(raw, color[x]);
+            PutLE32(raw, soft->GetDepthPixel(x, y));
+            PutLE32(raw, soft->GetAttrPixel(x, y));
+        }
+    }
+    char name[64];
+    snprintf(name, sizeof(name), "/frame_%06u_gx3d.bin", frame);
+    WriteFile(dir + name, raw);
+
+    // Keep a second, renderer-input-side artifact beside the resolved
+    // framebuffer.  This makes camera/matrix, clipping, polygon ordering,
+    // Z/W and interpolation defects distinguishable without copying any
+    // melonDS implementation into apricorn.  Signed fields are written as
+    // their little-endian two's-complement u32 representation.
+    std::vector<u8> geometry = {'A','P','G','X','G','E','O','1'};
+    auto& gx = nds.GPU.GPU3D;
+    PutLE32(geometry, gx.RenderDispCnt);
+    PutLE32(geometry, gx.RenderClearAttr1);
+    PutLE32(geometry, gx.RenderClearAttr2);
+    PutLE32(geometry, gx.FlushAttributes);
+    PutLE32(geometry, gx.RenderNumPolygons);
+    for (u32 i = 0; i < 16; i++) PutLE32(geometry, (u32)gx.ProjMatrix[i]);
+    for (u32 i = 0; i < 16; i++) PutLE32(geometry, (u32)gx.PosMatrix[i]);
+    for (u32 i = 0; i < 16; i++) PutLE32(geometry, (u32)gx.ClipMatrix[i]);
+
+    for (u32 i = 0; i < gx.RenderNumPolygons; i++)
+    {
+        const melonDS::Polygon* polygon = gx.RenderPolygonRAM[i];
+        PutLE32(geometry, polygon->Attr);
+        PutLE32(geometry, polygon->TexParam);
+        PutLE32(geometry, polygon->TexPalette);
+        PutLE32(geometry, polygon->NumVertices);
+        PutLE32(geometry, (u32)polygon->Type);
+        PutLE32(geometry, polygon->SortKey);
+        PutLE32(geometry, polygon->WBuffer ? 1 : 0);
+        u32 flags = (polygon->FacingView ? 1 : 0)
+                  | (polygon->Translucent ? 2 : 0)
+                  | (polygon->IsShadowMask ? 4 : 0)
+                  | (polygon->IsShadow ? 8 : 0)
+                  | (polygon->Degenerate ? 16 : 0);
+        PutLE32(geometry, flags);
+        for (u32 vertex = 0; vertex < polygon->NumVertices; vertex++)
+        {
+            const melonDS::Vertex* v = polygon->Vertices[vertex];
+            for (u32 component = 0; component < 4; component++)
+                PutLE32(geometry, (u32)v->Position[component]);
+            PutLE32(geometry, (u32)v->FinalPosition[0]);
+            PutLE32(geometry, (u32)v->FinalPosition[1]);
+            PutLE32(geometry, polygon->FinalZ[vertex]);
+            PutLE32(geometry, polygon->FinalW[vertex]);
+            for (u32 component = 0; component < 3; component++)
+                PutLE32(geometry, (u32)v->FinalColor[component]);
+            PutLE32(geometry, (u32)(s32)v->TexCoords[0]);
+            PutLE32(geometry, (u32)(s32)v->TexCoords[1]);
+        }
+    }
+    snprintf(name, sizeof(name), "/frame_%06u_gxgeo.bin", frame);
+    WriteFile(dir + name, geometry);
+    std::vector<u8> registers;
+    for (u32 i = 0; i < 8; i++) PutLE32(registers, gx.RenderEdgeTable[i]);
+    for (u32 i = 0; i < 32; i++) PutLE32(registers, gx.RenderToonTable[i]);
+    PutLE32(registers, gx.RenderFogColor);
+    PutLE32(registers, gx.RenderFogOffset);
+    PutLE32(registers, gx.RenderFogShift);
+    snprintf(name, sizeof(name), "/frame_%06u_gxregs.bin", frame);
+    WriteFile(dir + name, registers);
+}
+
+// Creates the shots directory if it is missing (its parent must exist).
+void EnsureDir(const std::string& dir)
+{
+#ifdef _WIN32
+    int rc = _mkdir(dir.c_str());
+#else
+    int rc = mkdir(dir.c_str(), 0755);
+#endif
+    if (rc != 0 && errno != EEXIST)
+    {
+        fprintf(stderr, "cannot create %s\n", dir.c_str());
+        exit(2);
+    }
+}
+
+// `--shots` value: comma-separated decimal frame indices.
+std::set<u32> ParseFrameList(const char* text)
+{
+    std::set<u32> frames;
+    std::string s(text);
+    size_t pos = 0;
+    while (pos <= s.size())
+    {
+        size_t comma = s.find(',', pos);
+        if (comma == std::string::npos) comma = s.size();
+        std::string item = s.substr(pos, comma - pos);
+        char* end = nullptr;
+        unsigned long v = strtoul(item.c_str(), &end, 10);
+        if (item.empty() || *end != '\0' || v > 0xFFFFFFFFul)
+        {
+            fprintf(stderr, "--shots: bad frame '%s' (want F,F,...)\n", item.c_str());
+            exit(64);
+        }
+        frames.insert(u32(v));
+        pos = comma + 1;
+    }
+    return frames;
+}
+
+// ----- blob formats (compiled by the Rust harness) -----------------------
+
+struct InputFrame
+{
+    u16 keymask; // melonDS SetKeyMask layout: A,B,Sel,Start,R,Lt,Up,Dn,Rt,L,X,Y = bits 0..11
+    bool touch_down;
+    u16 touch_x, touch_y;
+};
+
+struct InputScript
+{
+    std::vector<InputFrame> frames; // beyond the list: all-zero input
+};
+
+struct Region
+{
+    u32 addr, size, sample; // hash every `sample` frames
+    std::string name;
+};
+
+struct Probe
+{
+    u32 frame;      // run before that frame's input+execution
+    u32 entry;      // bit 0 = Thumb
+    u32 args[4];
+    std::string name;
+};
+
+InputScript ParseInput(Blob b)
+{
+    InputScript in;
+    u32 count = b.rd32();
+    in.frames.resize(count);
+    for (u32 i = 0; i < count; i++)
+    {
+        in.frames[i].keymask = b.rd16();
+        in.frames[i].touch_down = b.rd8() != 0;
+        (void)b.rd8(); // padding
+        in.frames[i].touch_x = b.rd16();
+        in.frames[i].touch_y = b.rd16();
+    }
+    return in;
+}
+
+std::vector<Region> ParseRegions(Blob b)
+{
+    u32 count = b.rd32();
+    std::vector<Region> regions(count);
+    for (u32 i = 0; i < count; i++)
+    {
+        regions[i].addr = b.rd32();
+        regions[i].size = b.rd32();
+        regions[i].sample = b.rd32();
+        regions[i].name = b.rdstr(b.rd32());
+    }
+    return regions;
+}
+
+std::vector<Probe> ParseProbes(Blob b)
+{
+    u32 count = b.rd32();
+    std::vector<Probe> probes(count);
+    for (u32 i = 0; i < count; i++)
+    {
+        probes[i].frame = b.rd32();
+        probes[i].entry = b.rd32();
+        u32 nargs = b.rd32();
+        if (nargs > 4) { fprintf(stderr, "corrupt probes blob: >4 args\n"); exit(2); }
+        // args[4] is always present in the blob (the doc contract); nargs
+        // says how many of them are meaningful.
+        for (u32 a = 0; a < 4; a++)
+            probes[i].args[a] = b.rd32();
+        probes[i].name = b.rdstr(b.rd32());
+    }
+    return probes;
+}
+
+// ----- machine ------------------------------------------------------------
+
+// Reads a region's bytes through the ARM9 bus (works for any mapped
+// region regardless of its backing store).
+std::vector<u8> ReadRegion(melonDS::NDS& nds, const Region& r)
+{
+    std::vector<u8> bytes(r.size);
+    for (u32 i = 0; i < r.size; i++)
+        bytes[i] = nds.ARM9Read8(r.addr + i);
+    return bytes;
+}
+
+// SHA-1 over the concatenation of all regions, in regions.conf order —
+// the `state` field of a C record. arm-runner's Rust probe computes
+// the identical digest over its own memory.
+std::string StateHash(melonDS::NDS& nds, const std::vector<Region>& regions)
+{
+    SHA1_CTX ctx;
+    SHA1Init(&ctx);
+    for (const Region& r : regions)
+    {
+        std::vector<u8> bytes = ReadRegion(nds, r);
+        SHA1Update(&ctx, bytes.data(), u32(bytes.size()));
+    }
+    unsigned char digest[20];
+    SHA1Final(digest, &ctx);
+    char hex[41];
+    for (int i = 0; i < 20; i++) sprintf(&hex[i*2], "%02x", digest[i]);
+    return std::string(hex, 40);
+}
+
+struct SavedARM9
+{
+    u32 R[16];
+    u32 CPSR;
+    s32 Cycles;
+    u64 Timestamp, Target;
+    u32 IME;
+};
+
+// Runs one probe: saves the ARM9, enters the leaf function exactly
+// like arm-runner's prepare_call, single-steps until the PC reaches
+// the sentinel (or the budget dies), emits a C record, restores.
+void RunProbe(melonDS::NDS& nds, const Probe& probe, u32 seq,
+              const std::vector<Region>& regions, FILE* out)
+{
+    SavedARM9 saved;
+    memcpy(saved.R, nds.ARM9.R, sizeof(saved.R));
+    saved.CPSR = nds.ARM9.CPSR;
+    saved.Cycles = nds.ARM9.Cycles;
+    saved.Timestamp = nds.ARM9Timestamp;
+    saved.Target = nds.ARM9Target;
+    saved.IME = nds.IME[0];
+
+    // Enter the leaf. IRQs off for the probe's duration: the machine
+    // is at a frame boundary, but a pending IRQ must not steal the PC.
+    nds.IME[0] = 0;
+    nds.ARM9.R[12] = 0;
+    for (int i = 0; i < 4; i++)
+        nds.ARM9.R[i] = probe.args[i];
+    nds.ARM9.R[13] = PROBE_STACK_TOP;
+    nds.ARM9.R[14] = PROBE_SENTINEL;
+    nds.ARM9.CPSR |= 0x80; // mask IRQs; JumpTo sets/clears the Thumb bit
+    nds.ARM9.JumpTo(probe.entry); // bit 0 picks Thumb
+
+    u32 steps = 0;
+    while (true)
+    {
+        // melonDS keeps R[15] as instruction address + (Thumb ? 2 : 4).
+        bool thumb = (nds.ARM9.CPSR & 0x20) != 0;
+        u32 cur = nds.ARM9.R[15] - (thumb ? 2 : 4);
+        if (cur == PROBE_SENTINEL)
+            break;
+        if (steps++ >= PROBE_STEP_BUDGET)
+        {
+            fprintf(stderr, "probe %s: exceeded %u steps without returning\n",
+                    probe.name.c_str(), PROBE_STEP_BUDGET);
+            exit(3);
+        }
+        // One instruction: the interpreter runs until the ARM9 clock
+        // reaches its target, so a one-cycle target steps exactly once.
+        nds.ARM9Target = nds.ARM9Timestamp + 1;
+        nds.ARM9.Execute<melonDS::CPUExecuteMode::Interpreter>();
+    }
+
+    fprintf(out, "C %u %s r0=0x%08x r1=0x%08x r2=0x%08x r3=0x%08x state=%s\n",
+            seq, probe.name.c_str(),
+            nds.ARM9.R[0], nds.ARM9.R[1], nds.ARM9.R[2], nds.ARM9.R[3],
+            StateHash(nds, regions).c_str());
+
+    // Restore. Registers and timing come back verbatim; JumpTo takes
+    // the *instruction address* (R[15] in melonDS is address+2/+4, so
+    // translate first, letting bit 0 re-select Thumb) and rebuilds the
+    // fetch state (NextInstr etc.) the probe trampled.
+    nds.IME[0] = saved.IME;
+    memcpy(nds.ARM9.R, saved.R, sizeof(saved.R));
+    nds.ARM9.CPSR = saved.CPSR;
+    nds.ARM9.Cycles = saved.Cycles;
+    nds.ARM9Timestamp = saved.Timestamp;
+    nds.ARM9Target = saved.Target;
+    bool was_thumb = (saved.CPSR & 0x20) != 0;
+    nds.ARM9.JumpTo(saved.R[15] - (was_thumb ? 2 : 4) | (was_thumb ? 1 : 0));
+}
+
+// ----- argument parsing ---------------------------------------------------
+
+struct Args
+{
+    std::string rom, out, producer = "oracle-melonds-1.1";
+    std::string input, regions, probes; // blob paths; regions required
+    u32 frames = 600;
+    std::string rtc = DEFAULT_RTC;
+    std::string input_sha1, regions_sha1; // passthrough header gates
+    std::set<u32> shots;                  // frames to screenshot (may be empty)
+    std::string shots_dir;                // where the PNGs go
+    std::set<u32> gx_shots;               // raw 3D planes to snapshot
+    std::string gx_shots_dir;
+};
+
+std::optional<Args> ParseArgs(int argc, char** argv)
+{
+    Args a;
+    // The leading `run` subcommand (the future sibling is `call`) is
+    // accepted but has no options of its own — the flags below define it.
+    int start = 1;
+    if (argc > 1 && !strcmp(argv[1], "run"))
+        start = 2;
+    for (int i = start; i < argc; i++)
+    {
+        auto next = [&](const char* what) -> const char*
+        {
+            if (i + 1 >= argc) { fprintf(stderr, "%s needs a value\n", what); exit(64); }
+            return argv[++i];
+        };
+        if (!strcmp(argv[i], "--rom")) a.rom = next("--rom");
+        else if (!strcmp(argv[i], "--out")) a.out = next("--out");
+        else if (!strcmp(argv[i], "--producer")) a.producer = next("--producer");
+        else if (!strcmp(argv[i], "--input")) a.input = next("--input");
+        else if (!strcmp(argv[i], "--regions")) a.regions = next("--regions");
+        else if (!strcmp(argv[i], "--probes")) a.probes = next("--probes");
+        else if (!strcmp(argv[i], "--frames")) a.frames = u32(atoi(next("--frames")));
+        else if (!strcmp(argv[i], "--rtc")) a.rtc = next("--rtc");
+        else if (!strcmp(argv[i], "--input-sha1")) a.input_sha1 = next("--input-sha1");
+        else if (!strcmp(argv[i], "--regions-sha1")) a.regions_sha1 = next("--regions-sha1");
+        else if (!strcmp(argv[i], "--shots")) a.shots = ParseFrameList(next("--shots"));
+        else if (!strcmp(argv[i], "--shots-dir")) a.shots_dir = next("--shots-dir");
+        else if (!strcmp(argv[i], "--gx-shots")) a.gx_shots = ParseFrameList(next("--gx-shots"));
+        else if (!strcmp(argv[i], "--gx-shots-dir")) a.gx_shots_dir = next("--gx-shots-dir");
+        else { fprintf(stderr, "unknown argument %s\n", argv[i]); exit(64); }
+    }
+    if (a.rom.empty() || a.out.empty() || a.regions.empty()
+        || a.input_sha1.empty() || a.regions_sha1.empty())
+        return std::nullopt;
+    if (!a.shots.empty() && a.shots_dir.empty())
+    {
+        fprintf(stderr, "--shots needs --shots-dir\n");
+        exit(64);
+    }
+    if (!a.gx_shots.empty() && a.gx_shots_dir.empty())
+    {
+        fprintf(stderr, "--gx-shots needs --gx-shots-dir\n");
+        exit(64);
+    }
+    return a;
+}
+
+} // namespace
+
+int main(int argc, char** argv)
+{
+    std::optional<Args> opt = ParseArgs(argc, argv);
+    if (!opt)
+    {
+        fprintf(stderr,
+            "usage: apricorn-oracle run --rom ROM.nds --out trace.txt\n"
+            "       --regions regions.bin [--input input.bin] [--probes probes.bin]\n"
+            "       [--frames N] [--rtc 2010-03-01T09:00:00]\n"
+            "       --input-sha1 HEX --regions-sha1 HEX [--producer NAME]\n"
+            "       [--shots F,F,... --shots-dir DIR]\n"
+            "       [--gx-shots F,F,... --gx-shots-dir DIR]\n");
+        return 64;
+    }
+    Args a = *opt;
+
+    // Pinned RTC. Any change here changes the trace — that's the point.
+    int year, month, day, hour, minute, second;
+    if (sscanf(a.rtc.c_str(), "%d-%d-%dT%d:%d:%d",
+               &year, &month, &day, &hour, &minute, &second) != 6)
+    {
+        fprintf(stderr, "--rtc must be YYYY-MM-DDTHH:MM:SS\n");
+        return 64;
+    }
+
+    std::vector<u8> romdata = ReadFile(a.rom.c_str());
+    std::string rom_sha1 = Sha1Hex(romdata.data(), romdata.size());
+    InputScript input = a.input.empty() ? InputScript{} : ParseInput({ReadFile(a.input.c_str())});
+    std::vector<Region> regions = ParseRegions({ReadFile(a.regions.c_str())});
+    std::vector<Probe> probes = a.probes.empty() ? std::vector<Probe>{} : ParseProbes({ReadFile(a.probes.c_str())});
+
+    if (!a.shots.empty())
+    {
+        EnsureDir(a.shots_dir);
+        for (u32 f : a.shots)
+            if (f >= a.frames)
+                fprintf(stderr, "warning: --shots frame %u is past --frames %u, never written\n", f, a.frames);
+    }
+    if (!a.gx_shots.empty())
+    {
+        EnsureDir(a.gx_shots_dir);
+        for (u32 f : a.gx_shots)
+            if (f >= a.frames)
+                fprintf(stderr, "warning: --gx-shots frame %u is past --frames %u, never written\n", f, a.frames);
+    }
+
+    // Boot: cart in, reset, pin the RTC, direct boot, go. Defaults all
+    // the way down (FreeBIOS + generated firmware + software renderer)
+    // — the exact configuration whose determinism we depend on.
+    melonDS::NDSArgs nds_args;
+    nds_args.JIT = std::nullopt;
+    // NDS is several megabytes (the memory-timing tables alone are ~4 MB) —
+    // melonDS's frontend heap-allocates it, and so do we.
+    std::unique_ptr<melonDS::NDS> nds(new melonDS::NDS(std::move(nds_args)));
+    nds->SetNDSCart(melonDS::NDSCart::ParseROM(romdata.data(), u32(romdata.size())));
+    nds->Reset();
+    nds->RTC.SetDateTime(year, month, day, hour, minute, second);
+    nds->SetupDirectBoot(a.rom);
+    nds->Start();
+    melonDS::NDS::Current = nds.get();
+
+    FILE* out = fopen(a.out.c_str(), "wb");
+    if (!out) { fprintf(stderr, "cannot write %s\n", a.out.c_str()); return 2; }
+    fprintf(out, "TRACE apricorn %s\n", TRACE_VERSION);
+    fprintf(out, "producer %s\n", a.producer.c_str());
+    fprintf(out, "state-format %s\n", STATE_FORMAT);
+    fprintf(out, "rom-sha1 %s\n", rom_sha1.c_str());
+    fprintf(out, "input-sha1 %s\n", a.input_sha1.c_str());
+    fprintf(out, "regions-sha1 %s\n", a.regions_sha1.c_str());
+    fprintf(out, "frames %u\n", a.frames);
+    fprintf(out, "frame-rate %s\n", FRAME_RATE);
+    fprintf(out, "rtc %s\n", a.rtc.c_str());
+
+    size_t next_probe = 0;
+    u32 seq = 0;
+    for (u32 frame = 0; frame < a.frames; frame++)
+    {
+        // Probes scheduled for this frame run at its boundary, before
+        // input or execution — the machine state of `frame-1` final.
+        while (next_probe < probes.size() && probes[next_probe].frame == frame)
+            RunProbe(*nds, probes[next_probe], seq++, regions, out), next_probe++;
+
+        const InputFrame& in = frame < input.frames.size()
+            ? input.frames[frame] : InputFrame{};
+        // The blob's keymask is "bit set = held" (the harness's
+        // canonical form); SetKeyMask stores its argument straight into
+        // the active-low KEYINPUT/EXTKEYIN registers (bit set = released
+        // — the Qt frontend starts from 0xFFF and clears bits on press),
+        // so the producer inverts at the edge. Passing the mask through
+        // unchanged holds every key during boot, and HeartGold's
+        // L+R+START+SELECT soft reset then reboots the game every ~220
+        // frames.
+        nds->SetKeyMask(~u32(in.keymask) & 0xFFF);
+        if (in.touch_down)
+            nds->TouchScreen(in.touch_x, in.touch_y);
+        else
+            nds->ReleaseScreen();
+
+        nds->RunFrame();
+
+        // A game-triggered stop (GBA mode, power-off, bad exception)
+        // ends the trace early — the emulated console is no longer
+        // producing state, and inventing frames would be a lie.
+        if (melonDS::Platform::Stopped())
+        {
+            fprintf(stderr, "machine stopped at frame %u — ending trace\n", frame);
+            fclose(out);
+            return 3;
+        }
+
+        // Screenshots see the frame exactly as the trace records it:
+        // after this frame's RunFrame, before anything else touches
+        // the machine. They never write to `out`.
+        if (a.shots.count(frame))
+            WriteShots(*nds, a.shots_dir, frame);
+        if (a.gx_shots.count(frame))
+            WriteGxShot(*nds, a.gx_shots_dir, frame);
+
+        for (const Region& r : regions)
+        {
+            if (r.sample == 0 || frame % r.sample == 0)
+            {
+                std::vector<u8> bytes = ReadRegion(*nds, r);
+                fprintf(out, "F %u %s %s\n", frame, r.name.c_str(),
+                        Sha1Hex(bytes.data(), bytes.size()).c_str());
+            }
+        }
+    }
+    // Probes scheduled at or past the last frame still run.
+    while (next_probe < probes.size())
+        RunProbe(*nds, probes[next_probe], seq++, regions, out), next_probe++;
+
+    fclose(out);
+    return 0;
+}
